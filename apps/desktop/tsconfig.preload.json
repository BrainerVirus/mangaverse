{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/preload",
    "rootDir": "./src/preload",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "noEmit": true
  },
  "include": ["src/preload/"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
