{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/renderer",
    "rootDir": "./src/renderer",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "jsx": "react-jsx",
    "noEmit": false
  },
  "include": ["src/renderer/"],
  "exclude": ["dist", "node_modules"]
}