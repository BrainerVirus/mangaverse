{
  "name": "@app/desktop",
  "version": "0.0.3",
  "private": true,
  "homepage": "https://github.com/BrainerVirus/mangaverse",
  "author": "BrainerVirus",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "bundle:main": "node scripts/bundle-main.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.preload.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "pretest": "node scripts/bundle-preload.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:electron": "playwright test --config playwright.config.ts",
    "test:e2e:packaged": "playwright test --config playwright.packaged.config.ts",
    "package:dir": "electron-builder --dir --publish never",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "package:linux": "electron-builder --linux --publish never",
    "lint": "oxlint src scripts",
    "lint:fix": "oxlint src scripts --fix",
    "clean": "rm -rf dist out release"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@app/platform": "workspace:*",
    "@app/shared": "workspace:*",
    "@app/web": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.87.0",
    "sql.js": "^1.15.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
