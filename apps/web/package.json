{
  "name": "@app/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app vite.config.ts",
    "lint:fix": "oxlint app vite.config.ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "clean": "rm -rf .vinxi .output dist"
  },
  "dependencies": {
    "@app/backup": "workspace:*",
    "@app/cache": "workspace:*",
    "@app/db": "workspace:*",
    "@app/design-system": "workspace:*",
    "@app/diagnostics": "workspace:*",
    "@app/extensions": "workspace:*",
    "@app/extensions-mangadex": "workspace:*",
    "@app/extensions-sdk": "workspace:*",
    "@app/library": "workspace:*",
    "@app/migration": "workspace:*",
    "@app/motion": "workspace:*",
    "@app/onboarding": "workspace:*",
    "@app/platform": "workspace:*",
    "@app/reader": "workspace:*",
    "@app/search": "workspace:*",
    "@app/settings": "workspace:*",
    "@app/shared": "workspace:*",
    "@app/storage": "workspace:*",
    "@app/theme": "workspace:*",
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.12.0",
    "tslib": "^2.8.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^30.1.2",
    "nitro": "^3.0.260311-beta",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.4"
  }
}
