{
  "$schema": "https://oxc.rs/schema.json",

  // Categories: high-signal only by default
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "warn"
  },

  // Plugins
  "plugins": ["typescript", "react", "jsx-a11y", "vitest"],

  // shadcn's design-system lint (JS plugin). `ui`/`componentImports` teach it that
  // the components live in @app/design-system (no per-component subpaths; the barrel
  // is the only import surface) and `note` points every finding at docs/Design.md.
  //
  // All six rules are `error` as of the lint-backlog slice (re-measured 2026-10-18
  // at c1b8980 before the sweep: no-restyle 94, no-arbitrary-values 157,
  // no-inline-styles 87, no-unknown-classes 3; after: 0 each, with the keeps below).
  // `pnpm lint` exits 0 and `pnpm run doctor` (which adopts this file) is green, so
  // doctor.config.ts no longer needs the rule carve-out it carried since ruling #1319.
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "ui": "@app/design-system",
      "componentImports": ["^@app/design-system(/|$)"],
      "note": "See docs/Design.md for the design rules and approved exceptions."
    }
  },

  // Rules
  "rules": {
    // `allow: ["layout"]` is the plugin's documented baseline (margin, width, flex,
    // positioning); the contracts below open the categories each component already
    // accepts in this codebase, so the policy matches today's rendering exactly.
    // Tighten a contract when a component's consumer contract is redesigned.
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          { "pattern": "^Button$", "allow": ["layout", "spacing", "color"] },
          { "pattern": "^Input$", "allow": ["layout", "spacing"] },
          { "pattern": "^Label$", "allow": ["layout", "typography"] },
          { "pattern": "^Separator$", "allow": ["layout", "color"] },
          { "pattern": "^Card$", "allow": ["layout", "color", "motion"] },
          { "pattern": "^CardHeader$", "allow": ["layout", "spacing"] },
          { "pattern": "^CardTitle$", "allow": ["layout", "typography"] },
          { "pattern": "^CardContent$", "allow": ["layout", "spacing"] },
          { "pattern": "^DialogFooter$", "allow": ["layout", "spacing"] },
          { "pattern": "^AlertDescription$", "allow": ["layout", "spacing"] }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    // Keeps: five values have no token or scale equivalent, so the class IS the
    // token here — `pt-[12vh]` (viewport-relative), `backdrop-blur-[2px]` (below
    // blur-xs 4px), `text-[10px]` (below text-xs 12px, the ⌘K keycap),
    // `pb-[env(safe-area-inset-bottom)]` (runtime env inset) and
    // `transition-[width]` (Tailwind has no width transition utility).
    // Allow-list entries are exact class strings, so nothing else slips through.
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "pt-[12vh]",
          "backdrop-blur-[2px]",
          "text-[10px]",
          "pb-[env(safe-area-inset-bottom)]",
          "transition-[width]"
        ]
      }
    ],
    // Keeps live in the file overrides at the bottom: virtualized grids, the reader
    // zoom/scroll layers and their jsdom fixtures set measurement output inline,
    // which no class can carry. Everything else in the repo is checked.
    "shadcn/no-inline-styles": "error",
    // `rounded-{box,control,badge,btn}` are the theme's own radius utilities
    // (@theme inline in packages/design-system/src/styles/globals.css) and Tailwind
    // does generate them — the built app CSS carries `.rounded-box{border-radius:.625rem}`
    // and `.rounded-control{border-radius:.4375rem}`. The plugin's Tailwind build
    // misses that namespace, so it reports them as unknown in package files only
    // (verified 2026-10-18: same class passes in a repo-root file, fails under
    // packages/*/src/**, while custom colors like `bg-surface` pass in both).
    // Allow-listing the four keeps the rule at `error` for real dead classes.
    "shadcn/no-unknown-classes": [
      "error",
      { "allow": ["rounded-box", "rounded-control", "rounded-badge", "rounded-btn"] }
    ],
    "shadcn/require-static-classes": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "no-console": "warn",
    "no-debugger": "error",
    "no-unused-vars": "error",

    // shortcut: rules oxlint 1.x newly promotes to `error` (plus the type-aware set that
    // only started running once oxlint-tsgolint was installed). The react/typescript
    // block is enabled now and clean: typescript/unbound-method, no-useless-empty-export,
    // react/set-state-in-effect, react/preserve-manual-memoization, react/refs,
    // react/incompatible-library and react/purity all report 0 findings (43 fixed,
    // measured 2026-10-17). Four keeps are
    // inline ignores with recorded rulings: react/set-state-in-effect on the two SSR
    // hooks (use-is-client, use-reduced-motion) and react/incompatible-library on the two
    // TanStack Virtual grids. The vitest family is enabled now and clean too: all five
    // rules report 0 findings (354 fixed, measured 2026-10-17 with the five rules forced
    // to `error`: require-mock-type-parameters 253, no-conditional-expect 99,
    // valid-expect 1, require-to-throw-message 1, expect-expect 0). The jsx-a11y block
    // is enabled too and clean: 14 findings fixed (measured 2026-10-18) — 5 real fixes
    // (`hr`, `output` x2, `fieldset` and the redundant `role="dialog"` on the Radix
    // Sheet) and 9 keeps as inline ignores with recorded rulings: role="dialog" on the
    // five hand-rolled div overlays (Backup, Migration, Storage, InstallProvider,
    // CommandPalette), the custom scrubber (reader-progress-rail) and progressbar
    // (OnboardingPage) widgets that `<input type="range">` / `<progress>` would
    // re-render, and the two pointer-only interaction handlers (sidebar hover-expand,
    // palette keyboard scope). Note for the record: ruling #552 counted 64
    // production typescript/no-redundant-type-constituents findings; the real count is 1 —
    // 62 more were "error type" artifacts of that rule and one was a
    // typescript/no-base-to-string artifact (62 + 1 = 63, the PR #58 CI lint error total).
    //
    // typescript/no-redundant-type-constituents and typescript/no-base-to-string are
    // dist-dependent and stay pinned: on a fresh checkout (CI lints before any
    // packages/*/dist exists) cross-package imports resolve to "error types" and these
    // two fire false positives — 62 + 1 errors in the PR #58 CI lint: 62
    // typescript/no-redundant-type-constituents + 1 typescript/no-base-to-string.
    // Their real findings (1 + 2) are fixed; re-enable them once lint depends on the
    // build (e.g. `turbo run lint`, whose task already declares dependsOn ["^build"]).
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-base-to-string": "off",
    "vitest/require-mock-type-parameters": "error",
    "vitest/no-conditional-expect": "error",
    "vitest/valid-expect": "error",
    "vitest/require-to-throw-message": "error",
    "vitest/expect-expect": "error"
  },

  // Environment
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },

  // File overrides
  "overrides": [
    // Package boundaries (AGENTS.md "Package Boundary Rules"): `no-restricted-imports`
    // scoped per package, measured 2026-10-18 with each rule forced on over
    // `npx oxlint apps packages` — 0 findings each; a planted `import ... from
    // '@app/library'` in packages/shared/src/index.ts fails the shared check.
    // The `**/` prefix matches absolute paths, so these globs keep working if the
    // config ever moves; the pre-existing bare globs (e.g. "apps/**/scripts/**")
    // anchor to this file's directory and are live at the repo root. Raw SQL
    // outside @app/db is the one mechanical rule deliberately NOT encoded and it
    // stays prose in AGENTS.md (no oxlint rule covers it; 0 production sites).
    {
      // @app/shared stays generic: no app shells, features, db, provider runtime or UI.
      "files": ["**/packages/shared/**"],
      "rules": { "no-restricted-imports": ["error", { "patterns": ["@app/**"] }] }
    },
    {
      // @app/motion holds no business logic, so it imports no app package at all.
      "files": ["**/packages/motion/**"],
      "rules": { "no-restricted-imports": ["error", { "patterns": ["@app/**"] }] }
    },
    {
      // @app/design-system imports no feature packages: only @app/shared and @app/motion.
      "files": ["**/packages/design-system/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": ["@app/**", "!@app/shared**", "!@app/motion**"] }
        ]
      }
    },
    {
      // Provider location (AGENTS.md: no provider-specific hacks outside
      // @app/extensions-core, @app/extensions-sdk or a provider extension package).
      // A provider's ids, mapping, Discover sections and page resolution live in
      // its own package; app code only reaches it through the registration seam
      // below. extensions-core and extensions-sdk are generic runtime layers, so
      // they stay allowed; a new provider package is covered by the glob with no
      // edit here.
      "files": ["**/apps/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@app/extensions-*",
              "!@app/extensions-core",
              "!@app/extensions-sdk"
            ]
          }
        ]
      }
    },
    {
      // Registration is the only legitimate app-side reference to a provider
      // package: the registry wires in its contract and id/mapping surface, and
      // the installer registers its bundled manifest. Their tests assert that
      // wiring, so they need the real manifest too.
      "files": [
        "**/apps/web/app/lib/provider-registry.ts",
        "**/apps/web/app/lib/first-party-providers.ts",
        "**/apps/web/app/lib/__tests__/provider-registry.test.ts",
        "**/apps/web/app/lib/__tests__/first-party-providers.test.ts"
      ],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // The component library and the theme layer are where the primitives are
      // authored, so their own components pass classes to their primitives by
      // design; no-restyle targets consumers restyling components and does not
      // apply here. The other three rules keep their remaining findings in these
      // two packages (60 + 10 no-arbitrary-values, 29 no-inline-styles at
      // c1b8980: Radix data-driven `min-w-[var(--radix-select-trigger-width)]`,
      // poster `aspect-[3/4]`, theme previews painting preset palettes inline).
      // feat/glass-foundation owns both packages and rebuilds them per DESIGN.md
      // §2/§3 (roadmap P1/P2); this override is the documented exception for that
      // slice's work and should be dropped when it lands.
      "files": ["**/packages/design-system/**", "**/packages/theme/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/no-unknown-classes": "off"
      }
    },
    {
      // Measurement output that no class can carry: the virtualized grids position
      // rows from the virtualizer, the reader layers transform from zoom/scroll
      // state, and their jsdom fixtures must set the box the virtualizer measures
      // (jsdom applies no CSS, so a class-based fixture would measure zero). The
      // properties are allow-listed per file group; colors, custom properties and
      // <style> elements stay checked, and every other file keeps the rule at error.
      "files": [
        "**/packages/library/src/components/VirtualLibraryGrid.tsx",
        "**/packages/search/src/components/VirtualSearchGrid.tsx"
      ],
      "rules": {
        "shadcn/no-inline-styles": [
          "error",
          {
            "allow": [
              "position",
              "top",
              "left",
              "width",
              "height",
              "transform",
              "display",
              "gridTemplateColumns",
              "gap"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/packages/library/src/components/VirtualLibraryGrid.test.tsx",
        "**/packages/search/src/components/VirtualSearchGrid.test.tsx"
      ],
      "rules": { "shadcn/no-inline-styles": ["error", { "allow": ["width", "height", "overflow"] }] }
    },
    {
      "files": [
        "**/packages/reader/src/components/ReaderScreen.tsx",
        "**/packages/reader/src/components/ReaderScrollView.tsx"
      ],
      "rules": {
        "shadcn/no-inline-styles": [
          "error",
          {
            "allow": [
              "width",
              "height",
              "top",
              "left",
              "transform",
              "transformOrigin",
              "touchAction",
              "flex",
              "overflow",
              "display",
              "flexDirection",
              "gap",
              "aspectRatio"
            ]
          }
        ]
      }
    },
    {
      "files": ["**/packages/onboarding/src/components/OnboardingPage.tsx"],
      "rules": {
        "shadcn/no-inline-styles": ["error", { "allow": ["width", "opacity"] }]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "no-console": "off",
        "no-unused-vars": "off",
        // Fixtures deliberately use raw palette names and non-Tailwind tokens
        // (e.g. `justify`) to exercise cn()'s merge behavior.
        "shadcn/no-raw-colors": "off",
        "shadcn/no-unknown-classes": "off"
      }
    },
    {
      "files": ["apps/web/app/routes/**", "apps/desktop/src/renderer/src/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["apps/**/scripts/**", "apps/**/*.mjs"],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["apps/desktop/src/main/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-console": "off"
      }
    }
  ],

  // Type-aware linting (requires tsconfig)
  "options": {
    "typeAware": true
  }
}
