{
  "$schema": "https://oxc.rs/schema.json",

  // Categories: high-signal only by default
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "warn"
  },

  // Plugins
  "plugins": ["typescript", "react", "jsx-a11y", "vitest"],

  // Rules
  "rules": {
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "no-console": "warn",
    "no-debugger": "error",
    "no-unused-vars": "error",

    // shortcut: rules oxlint 1.x newly promotes to `error` (plus the type-aware set that
    // only started running once oxlint-tsgolint was installed). The react/typescript
    // block is enabled now and clean: typescript/unbound-method, no-useless-empty-export,
    // react/set-state-in-effect, react/preserve-manual-memoization, react/refs,
    // react/incompatible-library and react/purity all report 0 findings (43 fixed,
    // measured 2026-10-17). Four keeps are
    // inline ignores with recorded rulings: react/set-state-in-effect on the two SSR
    // hooks (use-is-client, use-reduced-motion) and react/incompatible-library on the two
    // TanStack Virtual grids. Still pinned here, measured 2026-10-17 with this list forced
    // to `error`: 363 findings — 14 in production / 349 in tests. vitest family (later
    // slice): require-mock-type-parameters 248, no-conditional-expect 99, valid-expect 1,
    // require-to-throw-message 1, expect-expect 0. jsx-a11y (unrelated slice):
    // prefer-tag-over-role 12, no-noninteractive-element-interactions 2,
    // no-static-element-interactions 0. The two clean rules stay pinned with their family
    // so the list is re-measured in one go. Note for the record: ruling #552 counted 64
    // production typescript/no-redundant-type-constituents findings; the real count is 1 —
    // the other 63 were "error type" artifacts of linting a tree whose packages/*/dist was
    // not built yet.
    //
    // typescript/no-redundant-type-constituents and typescript/no-base-to-string are
    // dist-dependent and stay pinned: on a fresh checkout (CI lints before any
    // packages/*/dist exists) cross-package imports resolve to "error types" and these
    // two fire false positives — 63 + 1 errors in the PR #58 CI lint. Their real findings
    // (1 + 2) are fixed; re-enable them once lint depends on the build (e.g. `turbo run
    // lint`, whose task already declares dependsOn ["^build"]).
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-base-to-string": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/valid-expect": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/expect-expect": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off"
  },

  // Environment
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },

  // File overrides
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "no-console": "off",
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["apps/web/app/routes/**", "apps/desktop/src/renderer/src/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["apps/**/scripts/**", "apps/**/*.mjs"],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["apps/desktop/src/main/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-console": "off"
      }
    }
  ],

  // Type-aware linting (requires tsconfig)
  "options": {
    "typeAware": true
  }
}
