{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vinxi/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e:production": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["E2E_PORT"]
    },
    "clean": {
      "cache": false
    }
  },
  "agentGuidance": false
}
