{
  "expo": {
    "name": "mangaverse",
    "slug": "mangaverse",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mangaverse",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Mangaverse",
      "shortName": "Mangaverse",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "lang": "en"
    },
    "plugins": ["expo-router"],
    "extra": {
      "supportsDesktop": true
    }
  }
}
