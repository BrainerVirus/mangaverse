{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"baseUrl": "./",
		"lib": ["ES2015", "DOM"],
		"paths": {
			"@app/*": ["app/*"],
			"@assets/*": ["assets/*"],
			"@components/*": ["components/*"],
			"@constants/*": ["constants/*"],
			"@hooks/*": ["hooks/*"],
			"@lib/*": ["lib/*"],
			"@services/*": ["services/*"],
			"@stores/*": ["stores/*"],
			"@types/*": ["types/*"]
		}
	}
}
