{
	"printWidth": 150,
	"useTabs": true,
	"tabWidth": 2,
	"semi": true,
	"singleQuote": true,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-organize-imports", "prettier-plugin-tailwindcss"],
	"tailwindFunctions": ["cva", "clsx", "cn", "tw"],
	"overrides": [
		{
			"files": ["*.json", "*.md", "*.toml", "*.yml"],
			"options": {
				"useTabs": false
			}
		}
	]
}
