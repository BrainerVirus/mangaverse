{
  "name": "@app/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing/sqljs-harness.d.ts",
      "default": "./dist/testing/sqljs-harness.js"
    },
    "./migrations/0000_initial.sql": "./migrations/0000_initial.sql",
    "./migrations/meta/_journal.json": "./migrations/meta/_journal.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "drizzle-orm": "^0.40.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sql.js": "^1.4.9",
    "drizzle-kit": "^0.30.0",
    "oxlint": "^0.16.0",
    "sql.js": "^1.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
