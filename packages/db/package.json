{
  "name": "@app/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing/sqljs-harness.d.ts",
      "default": "./dist/testing/sqljs-harness.js"
    },
    "./migrations/0000_initial.sql": "./migrations/0000_initial.sql",
    "./migrations/0001_cache_asset_metadata.sql": "./migrations/0001_cache_asset_metadata.sql",
    "./migrations/meta/_journal.json": "./migrations/meta/_journal.json",
    "./migrations/0002_themes.sql": "./migrations/0002_themes.sql",
    "./migrations/0003_library_unique_manga.sql": "./migrations/0003_library_unique_manga.sql",
    "./migrations/0004_migration_history_undo.sql": "./migrations/0004_migration_history_undo.sql",
    "./migrations/0005_library_category_pinned.sql": "./migrations/0005_library_category_pinned.sql",
    "./migrations/0006_installed_extension_manifest_url.sql": "./migrations/0006_installed_extension_manifest_url.sql",
    "./migrations/0007_extension_logs.sql": "./migrations/0007_extension_logs.sql"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.87.0",
    "sql.js": "^1.14.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
