    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
