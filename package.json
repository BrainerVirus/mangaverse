{
  "name": "mangaverse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "turbo run test",
    "test:e2e:production": "turbo run test:e2e:production",
    "test:watch": "vitest watch",
    "bootstrap": "pnpm install",
    "lint": "oxlint apps packages vitest.config.ts",
    "lint:fix": "oxlint apps packages vitest.config.ts --fix",
    "format": "oxfmt apps packages .github types turbo.json package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json vitest.config.ts",
    "format:check": "oxfmt --check apps packages .github types turbo.json package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json vitest.config.ts",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "doctor": "react-doctor --yes --no-telemetry",
    "knip": "knip",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:desktop": "pnpm --filter @app/desktop dev",
    "dev": "pnpm dev:web",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "knip": "^6.41.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react-doctor": "^0.9.18",
    "tsc-alias": "^1.9.7",
    "turbo": "^2.11.7",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.0.0"
}
