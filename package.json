{
  "name": "mangaverse",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:fresh": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "commit": "git-cz",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,js,tsx,jsx}\" \"components/**/*.{ts,js,tsx,jsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,js,tsx,jsx}\" \"components/**/*.{ts,js,tsx,jsx}\"",
    "extensions:build": "rollup -c extensions/rollup.config.mjs",
    "prepare": "husky",
    "test": "jest --coverage=false",
    "test:watch": "jest --watch",
    "test:debug": "jest -o --watch",
    "test:final": "jest",
    "update:snapshots": "jest -u --coverage=false"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.56.0",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "^17.0.8",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "^9.0.8",
    "expo-secure-store": "^15.0.8",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "^15.0.10",
    "nativewind": "5.0.0-preview.2",
    "node-html-parser": "^6.1.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css": "3.0.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.1.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-testing-library": "^7.15.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-test-renderer": "19.1.0",
    "rollup": "^4.57.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@babel/core": "^7.28.0",
    "babel-plugin-syntax-hermes-parser": "0.33.3",
    "hermes-parser": "0.33.3",
    "hermes-estree": "0.33.3",
    "react-native-css": "3.0.0",
    "metro-runtime": "0.83.1",
    "@expo/metro-runtime": "6.1.2",
    "lightningcss": "1.30.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "private": true
}
