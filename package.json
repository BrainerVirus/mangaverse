{
  "name": "mangaverse",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "test": "turbo run test",
    "test:watch": "vitest watch",
    "bootstrap": "pnpm install",
    "lint": "oxlint apps packages vitest.config.ts",
    "lint:fix": "oxlint apps packages vitest.config.ts --fix",
    "format": "oxlint apps packages vitest.config.ts --format",
    "format:check": "oxlint apps packages vitest.config.ts --format --check-only",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:desktop": "pnpm --filter @app/desktop dev",
    "dev:install-mangadex": "node scripts/dev-install-mangadex.mjs",
    "dev": "pnpm dev:web",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.0",
    "oxlint": "^0.16.5",
    "turbo": "^2.9.10",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
