{
  "name": "mangaverse",
  "version": "1.0.0",
  "packageManager": "pnpm@11.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "legacy:start": "expo start",
    "legacy:start:fresh": "expo start -c",
    "legacy:android": "expo start --android",
    "legacy:ios": "expo start --ios",
    "legacy:web": "expo start --web",
    "legacy:web:export": "npx expo export -p web",
    "legacy:desktop:dev": "npx tauri dev",
    "legacy:desktop:build": "npm run legacy:web:export && npx tauri build",
    "legacy:extensions:build": "rollup -c extensions/rollup.config.mjs",
    "commit": "git-cz",
    "postinstall": "node scripts/patch-zustand.cjs",
    "prepare": "echo 'husky removed - monorepo migration in progress'",
    "test": "turbo run test",
    "test:watch": "vitest watch",
    "bootstrap": "pnpm install",
    "lint": "oxlint apps packages vitest.config.ts",
    "lint:fix": "oxlint apps packages vitest.config.ts --fix",
    "format": "oxlint apps packages vitest.config.ts --format",
    "format:check": "oxlint apps packages vitest.config.ts --format --check-only",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:desktop": "pnpm --filter @app/desktop dev",
    "dev": "pnpm dev:web",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.56.0",
    "@tauri-apps/api": "^2.5.0",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "^17.0.8",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "^9.0.8",
    "expo-secure-store": "^15.0.8",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "^15.0.10",
    "idb-keyval": "^6.2.1",
    "nativewind": "5.0.0-preview.2",
    "node-html-parser": "^6.1.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css": "3.0.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.1.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "oxlint": "^0.16.5",
    "postcss": "^8.5.6",
    "react-test-renderer": "19.1.0",
    "rollup": "^4.57.1",
    "tailwindcss": "^4.1.12",
    "turbo": "^2.9.10",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@babel/core": "^7.28.0",
    "babel-plugin-syntax-hermes-parser": "0.33.3",
    "hermes-parser": "0.33.3",
    "hermes-estree": "0.33.3",
    "react-native-css": "3.0.0",
    "metro-runtime": "0.83.1",
    "@expo/metro-runtime": "6.1.2",
    "lightningcss": "1.30.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "esbuild"
    ]
  },
  "private": true
}
