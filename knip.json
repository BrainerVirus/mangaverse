{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**"],
  "workspaces": {
    ".": {
      "entry": ["doctor.config.ts", "lint/team-conventions.cjs"],
      // The shadcn CLI is driven by opencode.json (the MCP server command) and the
      // documented `pnpm dlx shadcn@latest ...` invocations, never imported.
      "ignoreDependencies": ["shadcn"]
    },
    "apps/web": {
      "entry": ["e2e-production/**/*.spec.ts", "app/client.tsx"],
      // Generated by the TanStack Router plugin and rewritten on dev/build; its
      // route-type interfaces exist for the generated `Register` surface, which no
      // hand-written file imports.
      "ignore": ["app/routeTree.gen.ts"]
    },
    "apps/desktop": {
      "entry": ["src/preload/index.ts", "src/renderer/src/main.tsx"]
    }
  }
}
